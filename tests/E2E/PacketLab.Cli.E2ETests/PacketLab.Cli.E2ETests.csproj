<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <None Include="../../TestData/Pcap/ethernet-*.pcap;../../TestData/Pcap/multiple.pcap" Link="TestData/Pcap/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../../../src/PacketLab.Cli/PacketLab.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyCli" AfterTargets="Build">
    <ItemGroup>
      <CliFiles Include="../../../src/PacketLab.Cli/bin/$(Configuration)/$(TargetFramework)/PacketLab.*.dll" />
      <CliFiles Include="../../../src/PacketLab.Cli/bin/$(Configuration)/$(TargetFramework)/PacketLab.Cli.deps.json" />
      <CliFiles Include="../../../src/PacketLab.Cli/bin/$(Configuration)/$(TargetFramework)/PacketLab.Cli.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(CliFiles)" DestinationFolder="$(OutDir)cli" />
  </Target>
</Project>
