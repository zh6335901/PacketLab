<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PacketLab.Desktop.ViewModels.PacketExplorer"
             xmlns:controls="using:PacketLab.Desktop.Controls.PacketExplorer"
             xmlns:text="using:PacketLab.Desktop.Localization"
             x:Class="PacketLab.Desktop.Views.PacketExplorer.RecordInspector"
             x:DataType="vm:RecordInspectorViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="SelectionDetails" x:DataType="vm:ByteSelection">
      <Border BorderBrush="{x:Static controls:ViewStyle.Line}" BorderThickness="0,1,0,0">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="12,8,12,2">
            <TextBlock Text="{Binding Name}" FontFamily="{x:Static controls:ViewStyle.Mono}" FontSize="12"
                       Foreground="{x:Static controls:ViewStyle.Accent}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Range}" FontFamily="{x:Static controls:ViewStyle.Mono}" FontSize="11"
                       Foreground="{x:Static controls:ViewStyle.Accent}" FontWeight="SemiBold" />
          </Grid>
          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="12,2,12,9">
            <TextBlock Text="{Binding Raw}" FontFamily="{x:Static controls:ViewStyle.Mono}" FontSize="11" Foreground="{x:Static controls:ViewStyle.Muted}" />
            <TextBlock Grid.Column="1" Text="→" FontSize="11" Foreground="{x:Static controls:ViewStyle.Muted}" />
            <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="{x:Static controls:ViewStyle.Mono}" FontSize="11"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer x:Name="inspector" Margin="0,0,4,0" Focusable="True" HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.AutomationId="RecordDetails" AutomationProperties.Name="{x:Static text:Strings.RecordInspector}">
    <StackPanel x:Name="inspectionContent" Spacing="9" Margin="0,0,0,12" IsVisible="False">
      <ContentControl x:Name="recordHeading" />
      <ContentControl x:Name="recordExplanation" />
      <ContentControl x:Name="coverageSlot" Margin="0,0,0,4" />
      <ContentControl x:Name="evidenceSlot" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
