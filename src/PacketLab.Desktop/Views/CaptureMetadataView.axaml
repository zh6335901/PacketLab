<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PacketLab.Desktop"
             x:Class="PacketLab.Desktop.CaptureMetadataView"
             x:DataType="local:CaptureMetadata">
  <UserControl.Resources>
    <DataTemplate x:Key="FactTemplate" x:DataType="local:MetadataFact">
      <Border Padding="0,7" BorderBrush="{x:Static local:ViewStyle.Line}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="125,*">
          <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{x:Static local:ViewStyle.Muted}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.detail-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{x:Static local:ViewStyle.Muted}" />
    </Style>
    <Style Selector="TextBlock.detail-value">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontFamily" Value="{x:Static local:ViewStyle.Mono}" />
    </Style>
  </UserControl.Styles>
  <StackPanel>
    <ItemsControl ItemsSource="{Binding CaptureFacts}" ItemTemplate="{StaticResource FactTemplate}" />
    <ItemsControl ItemsSource="{Binding Interfaces}" IsVisible="{Binding HasInterfaces}" Margin="0,13,0,11">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:InterfaceCard">
          <Border Background="{x:Static local:ViewStyle.Bg}" BorderBrush="{x:Static local:ViewStyle.Line}"
                  BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,6,6">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Id}" FontFamily="{x:Static local:ViewStyle.Mono}" FontSize="10"
                         Foreground="{x:Static local:ViewStyle.Accent}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Name}" FontFamily="{x:Static local:ViewStyle.Mono}" FontSize="20" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Description}" Classes="detail-label" TextTrimming="CharacterEllipsis" />
              <StackPanel><TextBlock Text="链路" Classes="detail-label" /><TextBlock Text="{Binding Link}" Classes="detail-value" /></StackPanel>
              <StackPanel><TextBlock Text="字节序" Classes="detail-label" /><TextBlock Text="{Binding Order}" Classes="detail-value" /></StackPanel>
              <StackPanel><TextBlock Text="时间分辨率" Classes="detail-label" /><TextBlock Text="{Binding Resolution}" Classes="detail-value" /></StackPanel>
              <StackPanel><TextBlock Text="SnapLen" Classes="detail-label" /><TextBlock Text="{Binding SnapLength}" Classes="detail-value" /></StackPanel>
              <TextBlock Text="{Binding Extra}" Foreground="{x:Static local:ViewStyle.Soft}" FontFamily="{x:Static local:ViewStyle.Mono}"
                         FontSize="10" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding SectionsWithoutInterfaces}" ItemTemplate="{StaticResource FactTemplate}" />
    <TextBlock Text="{Binding RecordTitle}" IsVisible="{Binding HasRecord}" FontSize="12" FontWeight="SemiBold" Margin="0,5" />
    <ItemsControl ItemsSource="{Binding RecordFacts}" ItemTemplate="{StaticResource FactTemplate}" />
    <TextBlock Text="{Binding Path}" Foreground="{x:Static local:ViewStyle.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
  </StackPanel>
</UserControl>
