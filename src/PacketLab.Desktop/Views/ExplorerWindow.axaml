<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:text="using:PacketLab.Desktop.Localization"
        xmlns:controls="using:PacketLab.Desktop.Controls"
        xmlns:views="using:PacketLab.Desktop.Views"
        xmlns:vm="using:PacketLab.Desktop.ViewModels"
        xmlns:local="using:PacketLab.Desktop"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="PacketLab.Desktop.Views.ExplorerWindow"
        x:DataType="vm:ExplorerViewModel"
        Title="PacketLab · Packet Explorer" Icon="/Assets/PacketLab.ico"
        Width="1325" Height="885" MinWidth="480" MinHeight="530"
        ExtendClientAreaToDecorationsHint="True" WindowDecorations="BorderOnly"
        WindowStartupLocation="CenterScreen" Background="{x:Static local:ViewStyle.Bg}"
        Foreground="{x:Static local:ViewStyle.Text}" FontFamily="{x:Static local:ViewStyle.Body}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding ChooseFileCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <Style Selector="TextBlock.landing">
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontFamily" Value="{x:Static local:ViewStyle.Display}" />
      <Setter Property="FontSize" Value="27" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="30" />
    </Style>
    <Style Selector="TextBlock.metric-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{x:Static local:ViewStyle.Muted}" />
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="BorderBrush" Value="{x:Static local:ViewStyle.Line}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="Padding" Value="15,0" />
    </Style>
    <Style Selector="Grid.stacked-heading Border.metric"><Setter Property="Padding" Value="8,0" /></Style>
    <Style Selector="Grid.stacked-heading TextBlock.metric">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style Selector="TextBlock.workbench-title">
      <Setter Property="FontSize" Value="31" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontFamily" Value="{x:Static local:ViewStyle.Display}" />
    </Style>
    <Style Selector="Grid.stacked-heading TextBlock.workbench-title"><Setter Property="FontSize" Value="26" /></Style>
    <Style Selector="Button.filter">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{x:Static local:ViewStyle.Muted}" />
    </Style>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.caption.menu:pointerover"><Setter Property="Background" Value="#32363A" /></Style>
    <Style Selector="Button.caption.narrow"><Setter Property="Width" Value="36" /></Style>
    <Style Selector="Button.caption:pointerover"><Setter Property="Background" Value="#16FFFFFF" /></Style>
    <Style Selector="Button.caption:pressed"><Setter Property="Background" Value="#0DFFFFFF" /></Style>
    <Style Selector="Button.caption.close:pointerover"><Setter Property="Background" Value="#C42B1C" /></Style>
    <Style Selector="Button.caption.close:pressed"><Setter Property="Background" Value="#A92519" /></Style>
    <Style Selector="Button.caption:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#83C6F6" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Path.caption-glyph">
      <Setter Property="Stroke" Value="#EDEDED" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="32,*" ClipToBounds="True">
    <Border Background="#202225" BorderBrush="#393C41" BorderThickness="0,0,0,1"
            chrome:WindowDecorationProperties.ElementRole="TitleBar" AutomationProperties.Name="{x:Static text:Strings.TitleBar}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel x:Name="TitlePath" Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Path Fill="#83C6F6" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                  Data="M2 9L15 2L28 9L15 16Z M2 13L15 20L28 13V17L15 24L2 17Z M2 21L15 28L28 21V25L15 32L2 25Z" />
            <TextBlock Text="PacketLab" FontSize="13" FontWeight="SemiBold" Foreground="#F1F4F5" VerticalAlignment="Center" />
          </StackPanel>
          <Border Width="1" Height="14" Background="#42454B" VerticalAlignment="Center" />
          <Button x:Name="MobileNavigation" Classes="caption menu" CornerRadius="4" IsVisible="{Binding Navigation.IsNarrow}" Width="30" Height="29"
                  chrome:WindowDecorationProperties.ElementRole="User" Command="{Binding Navigation.ToggleDrawerCommand}"
                  AutomationProperties.Name="{Binding Navigation.DrawerAction}" ToolTip.Tip="{Binding Navigation.DrawerAction}">
            <Viewbox Width="19" Height="19">
              <Canvas Width="24" Height="24">
                <Path Data="M3 6H21 M3 12H21 M3 18H21" Stroke="#B6BBC3" StrokeThickness="1.5" StrokeLineCap="Round" />
              </Canvas>
            </Viewbox>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <TextBlock x:Name="CrumbCategory" Text="{x:Static text:Strings.TrafficAnalysis}" FontSize="12" Foreground="#B6BBC3" VerticalAlignment="Center" />
            <TextBlock x:Name="CrumbSeparator" Text="›" FontSize="12" Foreground="#B6BBC3" VerticalAlignment="Center" />
            <TextBlock Text="Packet Explorer" FontSize="12" Foreground="#EAECED" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="MinimizeButton" Classes="caption" Click="MinimizeWindow" AutomationProperties.Name="{x:Static text:Strings.MinimizeWindow}" ToolTip.Tip="{x:Static text:Strings.MinimizeWindow}"
                  chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
            <Path Classes="caption-glyph" Data="M1.5 6.5H10.5" />
          </Button>
          <Button x:Name="SizeButton" Classes="caption" Click="ToggleWindowSize" AutomationProperties.Name="{x:Static text:Strings.MaximizeWindow}" ToolTip.Tip="{x:Static text:Strings.MaximizeWindow}"
                  chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
            <Path Classes="caption-glyph" x:Name="SizeGlyph" />
          </Button>
          <Button x:Name="CloseWindowButton" Classes="caption close" Click="CloseWindow" AutomationProperties.Name="{x:Static text:Strings.CloseWindow}" ToolTip.Tip="{x:Static text:Strings.Close}"
                  chrome:WindowDecorationProperties.ElementRole="CloseButton">
            <Path Classes="caption-glyph" Data="M1.5 1.5L10.5 10.5 M10.5 1.5L1.5 10.5" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ClipToBounds="True">
      <views:ToolNavigationView x:Name="ToolRail" ZIndex="2" DataContext="{Binding Navigation}" />
      <Grid x:Name="ContentArea" Grid.Column="1">
        <Border x:Name="Landing" IsVisible="{Binding !Header.HasRecords}" Padding="20,28,20,100">
          <StackPanel MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:OpenCaptureIcon Width="54" Height="54" Margin="0,0,0,18" />
            <TextBlock Classes="landing" Text="{Binding Header.LandingTitle}" FontSize="24" LineHeight="32"
                       FontWeight="SemiBold" FontFamily="{x:Static local:ViewStyle.Display}" />
            <TextBlock Classes="landing" Text="{Binding Header.LandingHint}" Foreground="{x:Static local:ViewStyle.Muted}" Margin="0,7,0,0" />
            <Button Classes="choose-capture" HorizontalAlignment="Center" Margin="0,23,0,0" Command="{Binding ChooseFileCommand}"
                    AutomationProperties.Name="{Binding Header.LandingAction}">
              <TextBlock Text="{Binding Header.LandingAction}" Classes="landing" LineHeight="18" Foreground="#102333" FontWeight="SemiBold" />
            </Button>
            <TextBlock Classes="landing" Text="{Binding Header.Error}" IsVisible="{Binding Header.HasError}"
                       Foreground="{x:Static local:ViewStyle.Bad}" Margin="0,14,0,0" />
          </StackPanel>
        </Border>

        <Grid x:Name="Workbench" RowDefinitions="Auto,Auto,*,22" MaxWidth="1730" IsVisible="{Binding Header.HasRecords}">
          <Border Padding="0,14,0,17">
            <Grid x:Name="CaptureHeading" ColumnDefinitions="1.15*,0.85*" RowDefinitions="Auto,Auto" ColumnSpacing="26" RowSpacing="9">
              <Grid x:Name="CaptureSummary" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Border Width="20" Height="2" Background="{x:Static local:ViewStyle.Accent}" />
                    <TextBlock Text="PACKET EXPLORER" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.8"
                               FontFamily="{x:Static local:ViewStyle.Mono}" Foreground="{x:Static local:ViewStyle.Accent}" />
                  </StackPanel>
                  <TextBlock Text="{x:Static text:Strings.RecordWorkbench}" Classes="workbench-title" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Classes="metric"><StackPanel><TextBlock Classes="metric" Text="{Binding Header.Count}" /><TextBlock Classes="metric-label" Text="{x:Static text:Strings.Records}" /></StackPanel></Border>
                  <Border Classes="metric"><StackPanel><TextBlock Classes="metric" Text="{Binding Header.Groups}" /><TextBlock Classes="metric-label" Text="{x:Static text:Strings.FragmentGroups}" /></StackPanel></Border>
                  <Border Classes="metric"><StackPanel><TextBlock Classes="metric" Text="{Binding Header.Diagnostics}" Foreground="{x:Static local:ViewStyle.Warn}" /><TextBlock Classes="metric-label" Text="{x:Static text:Strings.DiagnosticRecords}" /></StackPanel></Border>
                </StackPanel>
              </Grid>
              <Border x:Name="FileBar" Grid.Column="1" Background="{x:Static local:ViewStyle.PanelBrush}" BorderBrush="{x:Static local:ViewStyle.Line}"
                      BorderThickness="1" CornerRadius="6" Padding="9,5" MinHeight="41" VerticalAlignment="Center">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                  <Button x:Name="FileButton" Classes="explorer" Command="{Binding ChooseFileCommand}" AutomationProperties.Name="{x:Static text:Strings.ChooseAnotherCapture}"
                          ToolTip.Tip="{x:Static text:Strings.ChooseAnotherCapture}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                      <Path Data="M6 3H14L18 7V21H6Z M14 3V8H18 M9 12H15 M9 16H15"
                            Width="16" Height="16" Stretch="Uniform" Stroke="{x:Static local:ViewStyle.Accent}" StrokeThickness="1.4" />
                      <TextBlock Grid.Column="1" Text="{Binding Header.File}" ToolTip.Tip="{Binding Header.File}" FontSize="13" FontWeight="SemiBold"
                                 FontFamily="{x:Static local:ViewStyle.Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Path Grid.Column="2" Data="M2 3L6 7L10 3" Width="10" Height="10" Stretch="Uniform" Stroke="{x:Static local:ViewStyle.Muted}" StrokeThickness="1.4" />
                    </Grid>
                  </Button>
                  <Border Grid.Column="1" Width="1" Height="15" Background="{x:Static local:ViewStyle.Line}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Header.Format}" FontSize="12" FontFamily="{x:Static local:ViewStyle.Mono}"
                             Foreground="{x:Static local:ViewStyle.Muted}" VerticalAlignment="Center" />
                  <Button Grid.Column="3" Classes="explorer" Command="{Binding ShowMetadataCommand}" AutomationProperties.Name="{x:Static text:Strings.CaptureMetadata}"
                          ToolTip.Tip="{x:Static text:Strings.CaptureMetadata}">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Path Data="M2 4H20V18H2Z M8 4V18 M11 8H17 M11 12H16" Width="16" Height="16" Stretch="Uniform"
                            Stroke="{x:Static local:ViewStyle.Muted}" StrokeThickness="1.4" />
                      <TextBlock Text="{x:Static text:Strings.MetadataButtonLabel}" FontSize="12" Foreground="{x:Static local:ViewStyle.Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Border Grid.Row="1" IsVisible="{Binding Header.HasError}" Background="{x:Static local:ViewStyle.BadBackground}"
                  BorderBrush="{x:Static local:ViewStyle.Bad}" BorderThickness="1" Padding="10,7" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <TextBlock Text="{x:Static text:Strings.FileReadError}" Foreground="{x:Static local:ViewStyle.Bad}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Header.Error}" Foreground="{x:Static local:ViewStyle.Bad}" FontSize="12" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <Grid x:Name="Workspace" Grid.Row="2" ColumnDefinitions="348,16,*">
            <Border Background="{x:Static local:ViewStyle.PanelBrush}" BorderBrush="{x:Static local:ViewStyle.CardBorder}"
                    BorderThickness="1" CornerRadius="8" ClipToBounds="True">
              <Grid RowDefinitions="Auto,*">
                <Border BorderBrush="{x:Static local:ViewStyle.Line}" BorderThickness="0,0,0,1" Padding="10,9,10,13">
                  <StackPanel Spacing="9">
                    <Grid x:Name="RecordToolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="RecordListTitle" Text="{x:Static text:Strings.CaptureRecords}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="RecordListCount" Text="{Binding ListCount}" FontSize="10" FontFamily="{x:Static local:ViewStyle.Mono}"
                                   Foreground="{x:Static local:ViewStyle.Muted}" VerticalAlignment="Center" />
                      </StackPanel>
                      <Border x:Name="RecordFilters" Grid.Column="1" BorderBrush="{x:Static local:ViewStyle.Line}" BorderThickness="1"
                              CornerRadius="4" Padding="2" Background="{x:Static local:ViewStyle.Bg}" HorizontalAlignment="Left">
                        <WrapPanel ItemSpacing="2" VerticalAlignment="Center">
                          <Button Classes="explorer filter" Classes.selected="{Binding AllSelected}" Content="{x:Static text:Strings.AllRecords}" AutomationProperties.Name="{x:Static text:Strings.AllRecords}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static local:RecordFilter.All}" />
                          <Button Classes="explorer filter" Classes.selected="{Binding DiagnosticsSelected}" Content="{x:Static text:Strings.Diagnostics}" AutomationProperties.Name="{x:Static text:Strings.Diagnostics}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static local:RecordFilter.Diagnostics}" />
                          <Button Classes="explorer filter" Classes.selected="{Binding FragmentsSelected}" Content="{x:Static text:Strings.Fragments}" AutomationProperties.Name="{x:Static text:Strings.Fragments}"
                                  Command="{Binding SetFilterCommand}" CommandParameter="{x:Static local:RecordFilter.Fragments}" />
                        </WrapPanel>
                      </Border>
                    </Grid>
                    <TextBox Classes="explorer" PlaceholderText="{x:Static text:Strings.SearchRecordsHint}" AutomationProperties.Name="{x:Static text:Strings.SearchRecords}"
                             Text="{Binding Query, Mode=TwoWay}">
                      <TextBox.InnerLeftContent>
                        <Path Margin="9,0,3,0" Width="13" Height="13" Data="M12 12L17 17 M14 8A6 6 0 1 1 2 8A6 6 0 0 1 14 8"
                              Stretch="Uniform" Stroke="{x:Static local:ViewStyle.Muted}" StrokeThickness="1.4" />
                      </TextBox.InnerLeftContent>
                    </TextBox>
                  </StackPanel>
                </Border>
                <Grid Grid.Row="1">
                  <ListBox x:Name="RecordList" Classes="records" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                           AutomationProperties.Name="{x:Static text:Strings.CaptureRecordList}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  </ListBox>
                  <WrapPanel ItemSpacing="2" VerticalAlignment="Top" IsVisible="{Binding NoMatches}">
                    <TextBlock Text="{x:Static text:Strings.NoMatchingRecords}" FontSize="12" Foreground="{x:Static local:ViewStyle.Muted}" Margin="12" VerticalAlignment="Center" />
                    <Button Classes="explorer" Command="{Binding ClearFilterCommand}">
                      <TextBlock Text="{x:Static text:Strings.ClearFilters}" FontSize="12" Foreground="{x:Static local:ViewStyle.Accent}" />
                    </Button>
                  </WrapPanel>
                </Grid>
              </Grid>
            </Border>
            <views:RecordInspectorView Grid.Column="2" DataContext="{Binding Inspector}" />
            <TextBlock Grid.Column="2" IsVisible="{Binding NoMatches}" Text="{x:Static text:Strings.NoRecordsWithFilters}"
                       FontSize="12" Foreground="{x:Static local:ViewStyle.Muted}" Margin="12" />
          </Grid>
          <Border Grid.Row="3" BorderBrush="{x:Static local:ViewStyle.Line}" BorderThickness="0,1,0,0" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Header.Footer}" FontSize="11" Foreground="{x:Static local:ViewStyle.Soft}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding FooterCount}" FontSize="11" Foreground="{x:Static local:ViewStyle.Soft}" />
            </Grid>
          </Border>
        </Grid>

      </Grid>
      <Border x:Name="DrawerShade" Grid.ColumnSpan="2" ZIndex="1" Opacity="0" Background="#75090B0D"
              IsHitTestVisible="False" />
    </Grid>

    <Grid x:Name="Overlay" Grid.Row="1" ZIndex="3" Background="#8F080D13" IsVisible="{Binding HasMetadata}">
      <Border x:Name="MetadataPane" MaxWidth="740" Background="#303135" BorderBrush="{x:Static local:ViewStyle.CardBorder}"
              BorderThickness="1" CornerRadius="8" Padding="22,17,22,20" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel Spacing="12">
          <Border BorderBrush="{x:Static local:ViewStyle.Line}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{x:Static text:Strings.CaptureMetadata}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="CloseButton" Grid.Column="1" Classes="explorer outline" Width="32" Height="32"
                      HorizontalContentAlignment="Center" Command="{Binding CloseMetadataCommand}" AutomationProperties.Name="{x:Static text:Strings.Close}">
                <TextBlock Text="×" FontSize="18" />
              </Button>
            </Grid>
          </Border>
          <ScrollViewer x:Name="MetadataScroll">
            <views:CaptureMetadataView DataContext="{Binding Metadata}" />
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
